PORT=3000
# Local play uses NODE_ENV=development so the placeholder secret below is allowed.
# Production must set NODE_ENV=production and a unique SESSION_SECRET of at least 32 characters.
NODE_ENV=development
SESSION_SECRET="lane-pusher-local"
AUTH_URL=https://formbar.yorktechapps.com
THIS_URL=http://localhost:3000
API_KEY=
POOL_ID=
POOL_PIN=
WIKI_REWARD_DIGIPOGS=10
ADMIN_USER_ID=
STARTING_MMR=1000
ELO_K=32
MMR_MAX_SPREAD=200
MATCH_WAIT_MS=60000
COUNTDOWN_MS=10000
BOT_COUNTDOWN_MS=5000
TICKET_PACK_SIZE=5
TICKET_PACK_COST=100

# Auth providers (at least one of LOCAL_ACCOUNTS / FORMBAR_LOGIN should be on for login)
LOCAL_ACCOUNTS=1
FORMBAR_LOGIN=1

# Email-backed auth flows (verify + forgot/reset). Requires SMTP_* when on.
AUTH_EMAIL=1

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Set TRUST_PROXY=1 only when Node is behind the existing Nginx proxy.
# Leave it unset for a direct local server so clients cannot spoof X-Forwarded-For.
TRUST_PROXY=0

# Optional operator token for GET /api/v1/metrics when METRICS=1.
# The route stays hidden unless this matches or the caller is an admin session.
METRICS_TOKEN=
