PORT=3000
# Local play uses NODE_ENV=development so the placeholder secret below is allowed.
# Production must set NODE_ENV=production and a unique SESSION_SECRET of at least 32 characters.
NODE_ENV=development
SESSION_SECRET="lane-pusher-local"
AUTH_URL=https://formbar.yorktechapps.com
# Public base URL (OAuth callbacks, emails). In development, phones on Wi‑Fi
# may open http://192.168.x.x:PORT; private LAN origins are allowed for sockets.
THIS_URL=http://localhost:3000
API_KEY=
POOL_ID=
POOL_PIN=
WIKI_REWARD_DIGIPOGS=10
ADMIN_USER_ID=
STARTING_MMR=1000
ELO_K=32
MMR_MAX_SPREAD=200
MATCH_WAIT_MS=60000
COUNTDOWN_MS=10000
BOT_COUNTDOWN_MS=5000
UNPAUSE_MS=60000
DISCONNECT_GRACE_MS=5000
RECONNECT_WAIT_MS=60000
TICKET_PACK_SIZE=5
TICKET_PACK_COST=100

# Auth providers (at least one of LOCAL_ACCOUNTS / FORMBAR_LOGIN / DISCORD_LOGIN should be on for login)
LOCAL_ACCOUNTS=1
FORMBAR_LOGIN=1
# Discord OAuth (opt-in). Redirect URI: {THIS_URL}/login/discord/callback
# Native app also uses {THIS_URL}/api/v1/login/discord/callback
DISCORD_LOGIN=0
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# In-match chat (play page bubble + Socket.IO). 1/true/on, 0/false/off. Default on when unset.
MATCH_CHAT=1

# Email-backed auth flows (verify + forgot/reset). Requires SMTP_* when on.
AUTH_EMAIL=1

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Set TRUST_PROXY=1 only when Node is behind the existing Nginx proxy.
# Leave it unset for a direct local server so clients cannot spoof X-Forwarded-For.
TRUST_PROXY=0

# Optional operator token for GET /api/v1/metrics when METRICS=1.
# The route stays hidden unless this matches or the caller is an admin session.
METRICS_TOKEN=

# Logging (Pino). Default level is info. Set LOG_LEVEL=debug for gameplay diagnostics.
# Production always emits JSON on stdout (warn+ also on stderr) for PM2.
# Development pretty-prints when stdout is a TTY unless LOG_PRETTY=0.
LOG_LEVEL=info
# LOG_PRETTY=0

