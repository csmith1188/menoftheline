PORT=3000
# Local play uses NODE_ENV=development so the placeholder secret below is allowed.
# Production must set NODE_ENV=production and a unique SESSION_SECRET of at least 32 characters.
NODE_ENV=development
SESSION_SECRET="lane-pusher-local"
AUTH_URL=https://formbar.yorktechapps.com
# Public base URL (OAuth callbacks, emails). In development, phones on Wi‑Fi
# may open http://192.168.x.x:PORT; private LAN origins are allowed for sockets.
THIS_URL=http://localhost:3000
# Production: redirect other Hosts (e.g. apex) to THIS_URL so lane.sid is not split across www/apex.
# CANONICAL_HOST_REDIRECT=0
# Packaged Electron/Capacitor clients: minimum supported wire protocol (default = PROTOCOL_VERSION).
# MOTL_MIN_PROTOCOL=1
# MOTL_SERVER_URL is for client:export / Electron only (not read by app.js).
# Optional cache-bust token for EJS ?v= and /api/v1/version.assetVersion.
# Default: git short SHA at process start (then CLIENT_VERSION if git unavailable).
# ASSET_VERSION=
API_KEY=
POOL_ID=
POOL_PIN=
WIKI_REWARD_DIGIPOGS=10
# Digipog reward pool sender (Formbar user id) — not site admin authorization.
ADMIN_USER_ID=
# One-time bootstrap: if no account has role=admin, promote this internal accounts.id once.
# After an admin exists, this is ignored. Prefer promoting via /admin/users thereafter.
ADMIN_BOOTSTRAP_ACCOUNT_ID=1
# Curated admin_events retention (days). Default 14.
# ADMIN_EVENT_RETAIN_DAYS=14
STARTING_MMR=1000
ELO_K=32
MMR_MAX_SPREAD=200
MATCH_WAIT_MS=60000
COUNTDOWN_MS=10000
BOT_COUNTDOWN_MS=5000
UNPAUSE_MS=60000
DISCONNECT_GRACE_MS=5000
RECONNECT_WAIT_MS=60000
TICKET_PACK_SIZE=5
TICKET_PACK_COST=100

# PayPal Checkout (USD ticket packages for non-Formbar accounts).
# Requires LOCAL_ACCOUNTS or DISCORD_LOGIN. Disabled for accounts with formbar_id.
# See docs/paypal.md for Developer Dashboard + webhook setup.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Optional: merchant id used to verify payee on capture
PAYPAL_MERCHANT_ID=

# Auth providers (at least one of LOCAL_ACCOUNTS / FORMBAR_LOGIN / DISCORD_LOGIN should be on for login)
LOCAL_ACCOUNTS=1
FORMBAR_LOGIN=1
# Discord OAuth (opt-in). Scopes: identify email. Redirect URI: {THIS_URL}/login/discord/callback
# Native app also uses {THIS_URL}/api/v1/login/discord/callback
# In Discord Developer Portal → OAuth2, enable the email scope and register both redirects.
DISCORD_LOGIN=0
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# In-match chat (play page bubble + Socket.IO). 1/true/on, 0/false/off. Default on when unset.
MATCH_CHAT=1

# When 1, Play vs bot and Random unranked cost a ticket (training modes stay free). Default 0.
NO_FREE=0

# Email-backed auth flows (verify + forgot/reset). Requires SMTP_* when on.
AUTH_EMAIL=1

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# News newsletter (admin mailer). Uses the same SMTP_* by default.
# DreamHost authenticated SMTP is ~100 recipients/hour — keep drip conservative.
# NEWS_MAIL_FROM=
# NEWS_MAIL_REPLY_TO=
# NEWS_MAIL_SENDER_NAME=Men Of The Line
# NEWS_MAIL_PHYSICAL_ADDRESS=
NEWS_MAIL_BATCH_SIZE=1
NEWS_MAIL_CONCURRENCY=1
NEWS_MAIL_DELAY_MS=60000
NEWS_MAIL_MAX_PER_HOUR=70
NEWS_MAIL_MAX_ATTEMPTS=5
# NEWS_MAIL_TICK_MS=5000

# Trust X-Forwarded-* from one Nginx hop. Auto-enabled when THIS_URL is https
# (required for Secure lane.sid cookies). Set TRUST_PROXY=1 explicitly for http
# proxies; leave unset/0 for direct local http://THIS_URL.
TRUST_PROXY=0

# Optional operator token for GET /api/v1/metrics when METRICS=1.
# The route stays hidden unless this matches or the caller is an admin session.
METRICS_TOKEN=

# Logging (Pino). Default level is info. Set LOG_LEVEL=debug for gameplay diagnostics.
# Production always emits JSON on stdout (warn+ also on stderr) for PM2.
# Development pretty-prints when stdout is a TTY unless LOG_PRETTY=0.
LOG_LEVEL=info
# LOG_PRETTY=0

