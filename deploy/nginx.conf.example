# Example reverse proxy for one Node process.
# Do not set PM2 instances above 1. Matchmaker, GameRoom, and GameSim
# live in that process. A Socket.IO Redis adapter does not copy sim state.
#
#   pm2 start app.js --name motl -i 1
#
# Nginx serves JS, CSS, images, shared modules, and BGM.
# Node keeps HTML, /api/, and /socket.io/.

upstream motl_node {
  server 127.0.0.1:3000;
  keepalive 16;
}

map $http_upgrade $connection_upgrade {
  default upgrade;
  "" close;
}

# Prefer one public host (match THIS_URL). Apex → www keeps lane.sid + Socket.IO Origin aligned.
server {
  listen 80;
  server_name example.com;
  return 302 https://www.example.com$request_uri;
}

server {
  listen 80;
  server_name www.example.com;

  root /var/www/menoftheline;

  location /socket.io/ {
    proxy_pass http://motl_node;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    # Idle sockets need longer than the default 60s (Engine.IO ping is 20s).
    proxy_read_timeout 86400s;
  }

  location /api/ {
    proxy_pass http://motl_node;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /js/ {
    alias /var/www/menoftheline/public/js/;
    # ESM imports (runtime.js) are not cache-busted by ?v= on the entry script.
    add_header Cache-Control "no-cache";
    etag on;
  }

  location /css/ {
    alias /var/www/menoftheline/public/css/;
    expires 1h;
    etag on;
  }

  location /shared/ {
    alias /var/www/menoftheline/shared/;
    expires 1h;
    etag on;
  }

  location /vendor/three/ {
    alias /var/www/menoftheline/node_modules/three/;
    expires 1h;
    etag on;
  }

  location /bgm/ {
    alias /var/www/menoftheline/public/bgm/;
    expires 7d;
    etag on;
  }

  location / {
    proxy_pass http://motl_node;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
