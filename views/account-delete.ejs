<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include("pwa-head") %>
  <title>Delete account · Men Of The Line</title>
  <link rel="stylesheet" href="/css/landing.css?v=<%= assetVersion %>">
</head>
<body>
  <div class="page">
    <%- include("header") %>
    <% if (notice) { %>
      <p class="notice" role="status"><%= notice %></p>
    <% } %>

    <section>
      <h2>Delete account</h2>
      <p class="hint">This cannot be undone. Your login will stop working immediately.</p>

      <h3>Removed</h3>
      <ul class="list">
        <li class="hint">Email, password, and linked Formbar / Discord logins</li>
        <li class="hint">Personal settings and active sessions</li>
        <li class="hint">Unused ticket balance (<%= ticketBalance %> ticket<%= ticketBalance === 1 ? "" : "s" %> will be forfeited)</li>
      </ul>

      <h3>Kept (anonymized)</h3>
      <ul class="list">
        <li class="hint">Match history and rankings, shown publicly as <strong>Fallen Soldier</strong></li>
        <li class="hint">Payment and ticket ledger records needed for accounting</li>
        <li class="hint">Aggregate analytics (activity is no longer counted as a live account)</li>
      </ul>

      <% if (!reauthOk) { %>
        <p class="notice" role="status">Sign in again to confirm you own this account.</p>
        <p>
          <% if (formbarLoginEnabled) { %>
            <a class="action" href="/login?formbar=1&amp;next=/account/delete">Sign in with Formbar</a>
          <% } %>
          <% if (discordLoginEnabled) { %>
            <a class="action" href="/login?discord=1&amp;next=/account/delete">Sign in with Discord</a>
          <% } %>
        </p>
      <% } else { %>
        <form method="post" action="/account/delete">
<%- include("csrf-field") %>
          <% if (hasPassword) { %>
            <label for="delete-password">Current password</label>
            <input id="delete-password" name="password" type="password" autocomplete="current-password" required>
          <% } %>
          <label for="delete-confirm">Type DELETE to confirm</label>
          <input id="delete-confirm" name="confirm" type="text" autocomplete="off" required placeholder="DELETE">
          <p class="hint">You will not be able to recover this account. The same email may register a new account later with no shared history.</p>
          <button type="submit" class="action">Permanently delete account</button>
        </form>
      <% } %>

      <p><a class="action" href="/profile/<%= viewer.id %>">Cancel</a></p>
    </section>
  </div>
</body>
</html>
