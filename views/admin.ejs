<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include("pwa-head") %>
  <title>Admin · Men Of The Line</title>
  <link rel="stylesheet" href="/css/landing.css">
</head>
<body>
  <div class="page">
    <%- include("header") %>
    <% if (notice) { %>
      <p class="notice" role="status"><%= notice %></p>
    <% } %>

    <section>
      <h2>System</h2>
      <dl class="stats">
        <div><dt>Accounts</dt><dd><%= admin.stats.accounts %></dd></div>
        <div><dt>Active games</dt><dd><%= admin.stats.active %></dd></div>
        <div><dt>Games played</dt><dd><%= admin.stats.finished %></dd></div>
        <div><dt>Ranked games</dt><dd><%= admin.stats.ranked %></dd></div>
        <div><dt>Tickets out</dt><dd><%= admin.stats.tickets %></dd></div>
        <div><dt>Digipogs spent</dt><dd><%= admin.stats.digipogs %></dd></div>
      </dl>
      <div class="stack admin-links">
        <a class="action" href="/admin/suggestions">Suggestions</a>
        <a class="action" href="/admin/wiki">Wiki</a>
      </div>
      <% if (!admin.games.length) { %>
        <p class="hint">No active games.</p>
      <% } else { %>
        <ul class="list">
          <% admin.games.forEach(function (game) { %>
            <li class="card">
              <p><%= game.players %></p>
              <p class="hint"><%= game.mode %> · <%= game.status %></p>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  </div>
  <%- include("suggestion-modal", { nextPath: "/admin" }) %>
</body>
</html>
