<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include("../pwa-head") %>
  <title><%= isNew ? "New news" : "Edit news" %> · Admin</title>
  <link rel="stylesheet" href="/css/landing.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/css/admin.css?v=<%= assetVersion %>">
</head>
<body>
  <div class="page">
    <%- include("../header") %>
    <% if (notice) { %><p class="notice" role="status"><%= notice %></p><% } %>
    <%- include("_nav") %>
    <% const e = entry || { id: "", date: "", title: "", category: "", emailSubject: "", summary: "", body: "", items: [] }; %>
    <section>
      <p class="hint"><a href="/admin/news">← News list</a></p>
      <h2><%= isNew ? "New news entry" : "Edit news" %></h2>
      <p class="hint">Eligible subscribers: <%= eligible %>. Hourly remaining: <%= mailBudget.remaining %>.</p>

      <div class="admin-panel">
        <form method="post" action="/admin/news/save" id="news-form">
          <%- include("../csrf-field") %>
          <label>ID (slug)
            <input name="id" value="<%= e.id || "" %>" maxlength="120" placeholder="auto from date + title if empty" <%= isNew ? "" : "readonly" %>>
          </label>
          <label>Date
            <input name="date" type="date" value="<%= e.date || "" %>" required>
          </label>
          <label>Title
            <input name="title" value="<%= e.title || "" %>" maxlength="200" required>
          </label>
          <label>Category
            <select name="category">
              <option value="">(none)</option>
              <% categories.forEach(function (cat) { %>
                <option value="<%= cat %>" <%= e.category === cat ? "selected" : "" %>><%= cat %></option>
              <% }) %>
            </select>
          </label>
          <label>Email subject (optional)
            <input name="emailSubject" value="<%= e.emailSubject || "" %>" maxlength="200" placeholder="Men Of The Line — …">
          </label>
          <label>Summary (markdown)
            <textarea name="summary" rows="4" style="width:100%"><%= e.summary || "" %></textarea>
          </label>
          <label>Body (markdown, optional)
            <textarea name="body" rows="8" style="width:100%"><%= e.body || "" %></textarea>
          </label>
          <label>Bullet items (one per line)
            <textarea name="itemsText" rows="8" style="width:100%"><%= (e.items || []).join("\n") %></textarea>
          </label>
          <div class="admin-actions">
            <button type="submit">Save (no email)</button>
            <button type="button" id="preview-btn" class="action">Refresh previews</button>
          </div>
        </form>
      </div>

      <div class="admin-panel">
        <h3>Previews</h3>
        <p class="hint" id="preview-subject"></p>
        <div class="admin-actions" style="margin-bottom:0.75rem">
          <button type="button" class="action preview-tab" data-tab="website">Website</button>
          <button type="button" class="action preview-tab" data-tab="email">Email HTML</button>
          <button type="button" class="action preview-tab" data-tab="text">Plain text</button>
        </div>
        <div id="preview-website" class="card patch news-item"></div>
        <iframe id="preview-email" title="Email preview" sandbox="" style="width:100%;min-height:320px;border:1px solid var(--line);background:#121821;display:none"></iframe>
        <pre id="preview-text" class="hint" style="white-space:pre-wrap;display:none"></pre>
      </div>

      <% if (!isNew && e.id) { %>
        <div class="admin-panel">
          <h3>Mailing</h3>
          <% if (campaignDetail) { %>
            <p class="hint">
              Campaign #<%= campaignDetail.id %>: <strong><%= campaignDetail.status %></strong><br>
              Sent <%= campaignDetail.sent %>, failed <%= campaignDetail.failed %>,
              pending <%= campaignDetail.pending %>, skipped <%= campaignDetail.skipped %>
              / <%= campaignDetail.total %>
            </p>
            <% if (campaignDetail.error_summary) { %>
              <p class="hint"><%= campaignDetail.error_summary %></p>
            <% } %>
            <% if (errors && errors.length) { %>
              <ul class="hint">
                <% errors.forEach(function (row) { %>
                  <li>#<%= row.account_id %> @<%= row.email_domain || "?" %>: <%= row.status %> — <%= row.last_error %></li>
                <% }) %>
              </ul>
            <% } %>
            <% if (campaignDetail.status === "queued" || campaignDetail.status === "sending") { %>
              <form method="post" action="/admin/news/campaigns/<%= campaignDetail.id %>/pause" style="display:inline">
                <%- include("../csrf-field") %>
                <input type="hidden" name="newsId" value="<%= e.id %>">
                <button type="submit">Pause</button>
              </form>
            <% } %>
            <% if (campaignDetail.status === "paused") { %>
              <form method="post" action="/admin/news/campaigns/<%= campaignDetail.id %>/resume" style="display:inline">
                <%- include("../csrf-field") %>
                <input type="hidden" name="newsId" value="<%= e.id %>">
                <button type="submit">Resume</button>
              </form>
            <% } %>
            <% if (campaignDetail.status === "queued" || campaignDetail.status === "sending" || campaignDetail.status === "paused") { %>
              <form method="post" action="/admin/news/campaigns/<%= campaignDetail.id %>/cancel" style="display:inline">
                <%- include("../csrf-field") %>
                <input type="hidden" name="newsId" value="<%= e.id %>">
                <label><input type="checkbox" name="confirm" value="1"> Confirm cancel</label>
                <button type="submit">Cancel campaign</button>
              </form>
            <% } %>
          <% } else { %>
            <p class="hint">No active campaign for this entry. Completed campaigns appear on the news list history.</p>
          <% } %>

          <form method="post" action="/admin/news/<%= encodeURIComponent(e.id) %>/test-send" style="margin-top:1rem">
            <%- include("../csrf-field") %>
            <button type="submit">Send test to my email</button>
          </form>

          <form method="post" action="/admin/news/<%= encodeURIComponent(e.id) %>/send" style="margin-top:1rem">
            <%- include("../csrf-field") %>
            <p class="hint">Send to all <%= eligible %> eligible subscribers (DreamHost drip). Requires confirmation.</p>
            <label><input type="checkbox" name="confirm" value="1"> I understand this queues email to opted-in users</label>
            <label>Type <strong>send</strong> to confirm
              <input name="confirmPhrase" autocomplete="off" maxlength="20">
            </label>
            <button type="submit">Send to all subscribers</button>
          </form>
        </div>

        <div class="admin-panel">
          <h3>Delete</h3>
          <form method="post" action="/admin/news/<%= encodeURIComponent(e.id) %>/delete">
            <%- include("../csrf-field") %>
            <label><input type="checkbox" name="confirm" value="1"> Confirm delete</label>
            <button type="submit">Delete entry</button>
          </form>
        </div>
      <% } %>
    </section>
  </div>
  <script>
    (function () {
      const form = document.getElementById("news-form");
      const csrf = form.querySelector('input[name="_csrf"]').value;
      const subjectEl = document.getElementById("preview-subject");
      const websiteEl = document.getElementById("preview-website");
      const emailEl = document.getElementById("preview-email");
      const textEl = document.getElementById("preview-text");
      let activeTab = "website";

      function showTab(tab) {
        activeTab = tab;
        websiteEl.style.display = tab === "website" ? "block" : "none";
        emailEl.style.display = tab === "email" ? "block" : "none";
        textEl.style.display = tab === "text" ? "block" : "none";
      }

      document.querySelectorAll(".preview-tab").forEach(function (btn) {
        btn.addEventListener("click", function () { showTab(btn.getAttribute("data-tab")); });
      });

      async function refreshPreview() {
        const body = new URLSearchParams(new FormData(form));
        body.set("_csrf", csrf);
        const res = await fetch("/admin/news/preview", {
          method: "POST",
          headers: { "content-type": "application/x-www-form-urlencoded", "X-CSRF-Token": csrf },
          body,
          credentials: "same-origin",
        });
        const data = await res.json();
        if (!data.ok) {
          subjectEl.textContent = data.error || "Preview failed";
          return;
        }
        subjectEl.textContent = "Subject: " + data.subject;
        websiteEl.innerHTML = data.websiteHtml;
        emailEl.srcdoc = data.emailHtml;
        textEl.textContent = data.plainText;
        showTab(activeTab);
      }

      document.getElementById("preview-btn").addEventListener("click", function () {
        refreshPreview().catch(function () { subjectEl.textContent = "Preview failed"; });
      });
      refreshPreview().catch(function () {});
    })();
  </script>
</body>
</html>
