<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include("../pwa-head") %>
  <title>Suggestions · Admin</title>
  <link rel="stylesheet" href="/css/landing.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/css/admin.css?v=<%= assetVersion %>">
</head>
<body>
  <div class="page">
    <%- include("../header") %>
    <% if (notice) { %><p class="notice" role="status"><%= notice %></p><% } %>
    <%- include("_nav") %>
    <section>
      <h2>Suggestions</h2>
      <p class="hint">Archive and Reward sends <%= rewardAmount %> digipogs, the same as a wiki revision.</p>
      <% if (!suggestions.length) { %>
        <p class="hint">No open suggestions.</p>
      <% } else { %>
        <ul class="list">
          <% suggestions.forEach(function (item) { %>
            <li class="card">
              <div class="suggest-meta">
                <% if (item.account_id) { %><a href="/admin/users/<%= item.account_id %>"><%= item.name %></a><% } else { %><%= item.name %><% } %>
                <span class="hint"><%= new Date(item.created_at).toLocaleString() %></span>
                <% if (item.is_bug) { %><span class="bug-tag">Bug</span><% } %>
              </div>
              <p class="suggest-body"><%= item.body %></p>
              <% if (item.is_bug && item.repro) { %>
                <p class="hint">How did you create the bug?</p>
                <p class="suggest-repro"><%= item.repro %></p>
              <% } %>
              <div class="wiki-admin-actions">
                <form method="post" action="/admin/suggestions/<%= item.id %>/archive">
                  <%- include("../csrf-field") %>
                  <button type="submit">Archive</button>
                </form>
                <% if (typeof isAdmin !== 'undefined' && isAdmin && item.formbar_id > 0) { %>
                  <form method="post" action="/admin/suggestions/<%= item.id %>/archive-reward">
                    <%- include("../csrf-field") %>
                    <button type="submit">Archive and Reward</button>
                  </form>
                <% } %>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  </div>
  <%- include("../suggestion-modal", { nextPath: "/admin/suggestions" }) %>
</body>
</html>
