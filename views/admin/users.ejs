<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include("../pwa-head") %>
  <title>Users · Admin</title>
  <link rel="stylesheet" href="/css/landing.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/css/admin.css?v=<%= assetVersion %>">
</head>
<body>
  <div class="page">
    <%- include("../header") %>
    <% if (notice) { %><p class="notice" role="status"><%= notice %></p><% } %>
    <%- include("_nav") %>
    <section>
      <h2>Users</h2>
      <form class="admin-filters" method="get" action="/admin/users">
        <label>Search<input type="search" name="q" value="<%= query.q %>" placeholder="Name, email, id…"></label>
        <label>Filter
          <select name="filter">
            <% ["", "banned", "deleted", "verified", "unverified", "recent", "local", "formbar", "discord", "multi", "admin", "moderator", "player"].forEach(function (f) { %>
              <option value="<%= f %>" <%= query.filter === f ? "selected" : "" %>><%= f || "All" %></option>
            <% }) %>
          </select>
        </label>
        <label>Sort
          <select name="sort">
            <% [["created_desc","Newest"],["created_asc","Oldest"],["name","Name"],["mmr","MMR"],["tickets","Tickets"],["last_seen","Last seen"]].forEach(function (pair) { %>
              <option value="<%= pair[0] %>" <%= query.sort === pair[0] ? "selected" : "" %>><%= pair[1] %></option>
            <% }) %>
          </select>
        </label>
        <button type="submit">Search</button>
      </form>
      <p class="admin-muted"><%= users.total %> accounts · page <%= users.page %></p>
      <table class="admin-table">
        <thead>
          <tr><th>ID</th><th>Name</th><th>Role</th><th>Email</th><th>MMR</th><th>Tickets</th><th>Status</th></tr>
        </thead>
        <tbody>
          <% users.rows.forEach(function (u) { %>
            <tr>
              <td class="admin-mono"><a href="/admin/users/<%= u.id %>"><%= u.id %></a></td>
              <td><a href="/admin/users/<%= u.id %>"><%= u.name %></a></td>
              <td><span class="admin-pill <%= u.role === 'admin' ? 'admin-role' : '' %>"><%= u.role || "player" %></span></td>
              <td><%= u.email || "—" %></td>
              <td><%= u.mmr %></td>
              <td><%= u.tickets %><% if (u.held) { %> (<%= u.held %>)<% } %></td>
              <td>
                <% if (u.banned_at && (!u.ban_expires_at || u.ban_expires_at > Date.now())) { %>
                  <span class="admin-pill banned">banned</span>
                <% } else if (u.email && !u.email_verified_at) { %>
                  unverified
                <% } else { %>
                  ok
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <div class="admin-actions">
        <% if (users.page > 1) { %>
          <a class="action" href="/admin/users?q=<%= encodeURIComponent(query.q) %>&filter=<%= query.filter %>&sort=<%= query.sort %>&page=<%= users.page - 1 %>">Prev</a>
        <% } %>
        <% if (users.page * users.pageSize < users.total) { %>
          <a class="action" href="/admin/users?q=<%= encodeURIComponent(query.q) %>&filter=<%= query.filter %>&sort=<%= query.sort %>&page=<%= users.page + 1 %>">Next</a>
        <% } %>
      </div>
    </section>
  </div>
</body>
</html>
