<form class="buy<%= typeof buyLayout !== "undefined" && buyLayout === "row" ? " buy--row" : "" %>" method="post" action="/tickets">
  <input type="hidden" name="next" value="<%= nextPath %>">
  <label for="pin">Digipog PIN</label>
  <div class="buy-fields">
    <input id="pin" name="pin" type="password" inputmode="numeric" autocomplete="off" placeholder="Enter your PIN" required>
    <button type="submit">Buy <%= packSize %> tickets for <%= packCost %> digipogs</button>
  </div>
</form>
