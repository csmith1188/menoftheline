<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include("pwa-head") %>
  <title><%= title %> · Men Of The Line</title>
  <link rel="stylesheet" href="/css/landing.css?v=<%= assetVersion %>">
</head>
<body>
  <div class="page">
    <%- include("header") %>

    <section class="error-panel" aria-labelledby="error-title">
      <p class="error-code" aria-hidden="true"><%= status %></p>
      <h2 id="error-title"><%= title %></h2>
      <p class="hint"><%= message %></p>
      <p><a class="action" href="/">Back home</a></p>
    </section>
  </div>
  <%- include("suggestion-modal", { nextPath: "/" }) %>
</body>
</html>
