<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include("pwa-head") %>
  <title>Forgot password · Men Of The Line</title>
  <link rel="stylesheet" href="/css/landing.css?v=<%= assetVersion %>">
</head>
<body>
  <div class="page">
    <%- include("header") %>
    <% if (notice) { %>
      <p class="notice" role="status"><%= notice %></p>
    <% } %>

    <section>
      <h2>Forgot password</h2>
      <p class="hint">Enter your email and we will send a reset link if an account exists.</p>
      <form method="post" action="/forgot">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required value="<%= email || "" %>">
        <button type="submit" class="action">Send reset link</button>
      </form>
      <p class="hint"><a href="/login">Back to log in</a></p>
    </section>
  </div>
  <%- include("suggestion-modal", { nextPath: "/forgot" }) %>
</body>
</html>
