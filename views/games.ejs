<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include("pwa-head") %>
  <title>Games · Men Of The Line</title>
  <link rel="stylesheet" href="/css/landing.css?v=<%= assetVersion %>">
</head>
<body>
  <div class="page">
    <%- include("header") %>
    <p id="games-notice" class="notice<%= notice ? "" : " hidden" %>" role="status"><%= notice || "" %></p>
    <% if (typeof communityFundingEnabled !== "undefined" && communityFundingEnabled) { %>
      <%- include("community-strip") %>
    <% } %>
    <div id="games-root">
      <p class="hint">Loading games…</p>
    </div>
  </div>
  <%# Always expose CSRF for guests: suggestion-modal is verified-only, but
      classic /play/* form POSTs and the static-asset session race still need it. %>
  <div class="hidden" aria-hidden="true">
    <%- include("csrf-field") %>
  </div>
  <%- include("suggestion-modal", { nextPath: "/games" }) %>
  <script type="module" src="/js/menus/games.js?v=<%= assetVersion %>"></script>
</body>
</html>
