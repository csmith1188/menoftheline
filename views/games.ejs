<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#121821">
  <title>Games · Men Of The Line</title>
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="stylesheet" href="/css/landing.css">
</head>
<body>
  <div class="page">
    <%- include("header") %>
    <% if (notice) { %>
      <p class="notice" role="status"><%= notice %></p>
    <% } %>

    <section>
      <h2>Play</h2>
      <div class="stack">
        <% if (rejoin) { %>
          <a class="action" href="/play">Rejoin match</a>
        <% } %>
        <div class="play-split play-thirds">
          <form method="post" action="/play/bot">
            <button type="submit" <%= rejoin ? "disabled" : "" %>>Play vs bot</button>
          </form>
          <form method="post" action="/play/train/bot">
            <button type="submit" <%= rejoin ? "disabled" : "" %>>Train vs bot</button>
          </form>
          <form method="post" action="/play/bot">
            <input type="hidden" name="view" value="3d">
            <button type="submit" <%= rejoin ? "disabled" : "" %> title="Play vs bot in 3D" aria-label="Play vs bot in 3D">3D</button>
          </form>
        </div>
        <div class="play-split play-thirds">
          <form method="post" action="/play/casual">
            <button type="submit" <%= rejoin ? "disabled" : "" %>>Random unranked</button>
          </form>
          <form method="post" action="/play/train/casual">
            <button type="submit" <%= rejoin ? "disabled" : "" %>>Train vs random</button>
          </form>
          <form method="post" action="/play/casual">
            <input type="hidden" name="view" value="3d">
            <button type="submit" <%= rejoin ? "disabled" : "" %> title="Random unranked in 3D" aria-label="Random unranked in 3D">3D</button>
          </form>
        </div>
        <% if (viewer) { %>
          <div class="play-split">
            <form method="post" action="/play/lobby">
              <button type="submit" <%= canTicket ? "" : "disabled" %>>Create unranked lobby</button>
            </form>
            <form method="post" action="/play/lobby">
              <input type="hidden" name="view" value="3d">
              <button type="submit" <%= canTicket ? "" : "disabled" %> title="Create unranked lobby in 3D" aria-label="Create unranked lobby in 3D">3D</button>
            </form>
          </div>
          <div class="play-split">
            <form method="post" action="/play/ranked">
              <button type="submit" <%= canTicket ? "" : "disabled" %>>Find ranked match</button>
            </form>
            <form method="post" action="/play/ranked">
              <input type="hidden" name="view" value="3d">
              <button type="submit" <%= canTicket ? "" : "disabled" %> title="Find ranked match in 3D" aria-label="Find ranked match in 3D">3D</button>
            </form>
          </div>
          <% if (!canTicket && !rejoin) { %>
            <p class="hint">A free ticket is required for a lobby, a specific join, or ranked search.</p>
          <% } %>
          <%- include("buy", { nextPath: "/games" }) %>
        <% } %>
      </div>
    </section>

    <section>
      <h2>Open games</h2>
      <% if (!lobbies.length) { %>
        <p class="hint">No open games.</p>
      <% } %>
      <ul class="list">
        <% lobbies.forEach(function (lobby) { %>
          <li class="card">
            <p><%= lobby.host %></p>
            <% if (rejoin) { %>
              <p class="hint">You are already in a match.</p>
            <% } else if (!viewer) { %>
              <p class="hint">Log in to join.</p>
            <% } else if (!canTicket) { %>
              <p class="hint">You need a free ticket.</p>
            <% } else { %>
              <div class="play-split">
                <form method="post" action="/play/join/<%= lobby.id %>">
                  <button type="submit">Join</button>
                </form>
                <form method="post" action="/play/join/<%= lobby.id %>">
                  <input type="hidden" name="view" value="3d">
                  <button type="submit" title="Join in 3D" aria-label="Join in 3D">3D</button>
                </form>
              </div>
            <% } %>
          </li>
        <% }) %>
      </ul>
    </section>
  </div>
  <%- include("suggestion-modal", { nextPath: "/games" }) %>
</body>
</html>
