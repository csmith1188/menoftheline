<header class="top">
  <a class="brand" href="/">
    <img src="/img/logoA.png" alt="Men Of The Line" style="max-width: 100%; height: auto; display: block;">
  </a>
  <nav class="site-nav" aria-label="Site">
    <a href="/" class="<%= typeof nav !== 'undefined' && nav === 'home' ? 'active' : '' %>"> [ Home ]</a>
    <a href="/games" class="<%= typeof nav !== 'undefined' && nav === 'games' ? 'active' : '' %>"> [ Games ]</a>
    <a href="/scores" class="<%= typeof nav !== 'undefined' && nav === 'scores' ? 'active' : '' %>"> [ High Scores ]</a>
    <a href="/rules" class="<%= typeof nav !== 'undefined' && nav === 'rules' ? 'active' : '' %>"> [ Rules ]</a>
    <% if (viewer && accountEmailVerified(viewer)) { %>
      <button type="button" class="nav-link" id="suggest-open">[ Suggest ]</button>
    <% } %>
    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
      <a href="/admin" class="<%= typeof nav !== 'undefined' && nav === 'admin' ? 'active' : '' %>"> [ Admin ]</a>
    <% } %>
    <% if (viewer) { %>
      <a href="/profile/<%= viewer.id %>">[ <%= viewer.name %> ]</a>
      <a href="/buy" class="<%= typeof nav !== 'undefined' && nav === 'buy' ? 'active' : '' %>"><%= viewer.tickets %> tickets<% if (viewer.held > 0) { %> (<%= viewer.held %> in use)<% } %></a>
      <a href="/logout"> [ Log out ]</a>
    <% } else if (typeof anyLoginEnabled === 'undefined' || anyLoginEnabled) { %>
      <a href="/login"> [ Log in ]</a>
    <% } %>
  </nav>
</header>
