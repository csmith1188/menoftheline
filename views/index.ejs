<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#121821">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <title>Men Of The Line</title>
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="stylesheet" href="/css/game.css">
</head>
<body>
  <div class="shell">
    <div class="stage">
      <canvas id="board" width="960" height="620" role="img" aria-label="Lane map"></canvas>
      <div id="lobby" class="banner">
        <p id="lobby-you" class="sub"></p>
        <p id="lobby-text">Connecting...</p>
        <button type="button" id="lobby-leave" class="action">Leave</button>
      </div>
      <div id="banner" class="banner hidden">
        <p id="banner-text"></p>
        <button type="button" id="leave" class="action">Leave</button>
      </div>
      <button type="button" id="gear" class="gear" aria-label="Menu">⚙</button>
      <div id="menu" class="menu hidden">
        <p class="label">You</p>
        <p id="menu-you" class="value"></p>
        <p class="label">Opponent</p>
        <p id="opp-name" class="value"></p>
        <p id="opp-kind" class="value"></p>
        <button type="button" id="howto" class="action" aria-controls="rules" aria-expanded="false">How to play</button>
        <button type="button" id="southpaw" class="action southpaw" aria-pressed="false" title="Blue on the right">
          Southpaw
          <span class="mark" aria-hidden="true"></span>
        </button>
        <div class="sound">
          <div class="sound-head">
            <span>Sound</span>
            <button type="button" id="sound-mute" class="sound-mute" aria-pressed="false" title="Mute sound">Mute</button>
          </div>
          <input type="range" id="sound-volume" min="0" max="100" step="1" value="100" aria-label="Sound volume">
        </div>
        <button type="button" id="concede" class="action">Concede</button>
        <div id="confirm" class="confirm hidden">
          <p>Concede this match?</p>
          <button type="button" id="concede-yes" class="action">Concede</button>
          <button type="button" id="concede-no" class="action">Cancel</button>
        </div>
      </div>
      <div id="rules" class="rules hidden" role="dialog" aria-modal="true" aria-labelledby="rules-title" tabindex="-1">
        <div class="rules-card">
          <div class="rules-head">
            <h2 id="rules-title"></h2>
            <button type="button" id="rules-close" class="action">Close</button>
          </div>
          <div class="rules-body">
            <canvas id="rules-art" width="640" height="260" aria-hidden="true"></canvas>
            <div id="rules-copy" class="rules-copy"></div>
          </div>
          <div class="rules-nav">
            <button type="button" id="rules-prev" class="action">Back</button>
            <div class="rules-mid">
              <div id="rules-dots" class="rules-dots"></div>
              <p id="rules-page"></p>
            </div>
            <button type="button" id="rules-next" class="action">Next</button>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script src="/socket.io/socket.io.js"></script>
  <script type="module" src="/js/main.js"></script>
</body>
</html>
