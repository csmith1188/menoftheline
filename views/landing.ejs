<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include("pwa-head") %>
  <title>Men Of The Line</title>
  <link rel="stylesheet" href="/css/landing.css?v=<%= assetVersion %>">
</head>
<body>
  <div class="page">
    <%- include("header") %>
    <% if (notice) { %>
      <p class="notice" role="status"><%= notice %></p>
    <% } %>
    <section>
      <ul class="list">
        <li class="card patch">
          <h2>Men of the Line Beta</h2>
          <p>Men of the Line is a pocket real-time strategy game based on musket line warfare. As a Colonel, deploy and lead your battalions across the lanes, align them in formations, and execute daring ploys.</p>
          <p>Many things will feel broken and "janky". Drop Bug reports and suggestions and I'll address them as soon as I can.</p>
        </li>
      </ul>
    </section>
    <section>
      <a id="top"></a>
      <h2>News</h2>
      <% if (!news.length) { %>
        <p class="hint">No news yet.</p>
      <% } else { %>
        <ul class="list" id="news-list">
          <% news.forEach(function (item) { %>
            <li class="card patch news-item">
              <%- newsWebsiteHtml(item) %>
            </li>
          <% }) %>
        </ul>
        <% if (news.length > 5) { %>
          <div class="news-pager" id="news-pager" hidden>
            <a href="#top" class="news-pager-btn" id="news-prev" aria-label="Newer news">Newer</a>
            <p class="hint" id="news-page-label" aria-live="polite"></p>
            <a href="#top" class="news-pager-btn" id="news-next" aria-label="Older news">Older</a>
          </div>
        <% } %>
      <% } %>
    </section>
  </div>
  <%- include("suggestion-modal", { nextPath: "/" }) %>
  <script>
    // Warm match music in the HTTP cache before /play so Socket.IO stays free in-match.
    (function () {
      try {
        if (typeof fetch === "function") {
          fetch("/bgm/HTL.ogg", { cache: "force-cache", credentials: "same-origin" }).catch(function () {});
        }
      } catch (err) {}
    })();

    (function () {
      const PAGE = 5;
      const items = Array.prototype.slice.call(document.querySelectorAll("#news-list .news-item"));
      const pager = document.getElementById("news-pager");
      if (!pager || items.length <= PAGE) return;
      const prev = document.getElementById("news-prev");
      const next = document.getElementById("news-next");
      const label = document.getElementById("news-page-label");
      const pages = Math.ceil(items.length / PAGE);
      let page = 0;

      function show() {
        const start = page * PAGE;
        const end = start + PAGE;
        for (let i = 0; i < items.length; i += 1) {
          items[i].hidden = i < start || i >= end;
        }
        label.textContent = (page + 1) + " / " + pages;
        prev.disabled = page <= 0;
        next.disabled = page >= pages - 1;
        pager.hidden = false;
      }

      prev.addEventListener("click", function () {
        if (page <= 0) return;
        page -= 1;
        show();
      });
      next.addEventListener("click", function () {
        if (page >= pages - 1) return;
        page += 1;
        show();
      });
      show();
    })();
  </script>
</body>
</html>
