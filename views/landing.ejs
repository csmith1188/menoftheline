<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include("pwa-head") %>
  <title>Men Of The Line</title>
  <link rel="stylesheet" href="/css/landing.css?v=<%= assetVersion %>">
</head>
<body>
  <div class="page">
    <%- include("header") %>
    <% if (notice) { %>
      <p class="notice" role="status"><%= notice %></p>
    <% } %>

    <section>
      <h2>News</h2>
      <% if (!news.length) { %>
        <p class="hint">No news yet.</p>
      <% } else { %>
        <ul class="list">
          <% news.forEach(function (item) { %>
            <li class="card patch">
              <p class="hint"><%= item.date %></p>
              <h3><%= item.title %></h3>
              <% if (item.summary) { %><p><%= item.summary %></p><% } %>
              <% if (item.items && item.items.length) { %>
                <ul class="notes">
                  <% item.items.forEach(function (line) { %>
                    <li><%= line %></li>
                  <% }) %>
                </ul>
              <% } %>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  </div>
  <%- include("suggestion-modal", { nextPath: "/" }) %>
  <script>
    // Warm match music in the HTTP cache before /play so Socket.IO stays free in-match.
    (function () {
      try {
        if (typeof fetch === "function") {
          fetch("/bgm/HTL.ogg", { cache: "force-cache", credentials: "same-origin" }).catch(function () {});
        }
      } catch (err) {}
    })();
  </script>
</body>
</html>
