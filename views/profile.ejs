<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include("pwa-head") %>
  <title><%= account ? account.name : "Player" %> · Men Of The Line</title>
  <link rel="stylesheet" href="/css/landing.css?v=<%= assetVersion %>">
</head>
<body>
  <div class="page">
    <%- include("header") %>
    <% if (notice) { %>
      <p class="notice" role="status"><%= notice %></p>
    <% } %>
    <% if (!account) { %>
      <section>
        <h2>Player not found</h2>
        <p class="hint">No account uses that id.</p>
        <a class="action" href="/">Back</a>
      </section>
    <% } else { %>
      <section>
        <h2><%= account.name %></h2>
        <dl class="stats">
          <div><dt>MMR</dt><dd><%= account.mmr %></dd></div>
          <div><dt>Wins</dt><dd><%= account.wins %></dd></div>
          <div><dt>Losses</dt><dd><%= account.losses %></dd></div>
          <div><dt>Ranked games</dt><dd><%= account.wins + account.losses %></dd></div>
          <div><dt>Time played</dt><dd><%= formatPlayDuration(playStats.totalMs) %></dd></div>
          <% if (isOwner) { %>
            <div><dt>Tickets</dt><dd><%= account.tickets %></dd></div>
          <% } %>
        </dl>
      </section>
      <section>
        <h2>MMR history</h2>
        <% if (!mmrHistory.total) { %>
          <p class="hint">No ranked games recorded yet.</p>
        <% } else { %>
          <div class="mmr-history-wrap">
            <table class="mmr-history">
              <thead>
                <tr>
                  <th>When</th>
                  <th>Opponent</th>
                  <th>Result</th>
                  <th>Δ MMR</th>
                  <th>MMR after</th>
                </tr>
              </thead>
              <tbody>
                <% mmrHistory.rows.forEach(function (row) { %>
                  <tr>
                    <td><%= new Date(row.endedAt).toLocaleString() %></td>
                    <td>
                      <% if (row.opponentAccountId) { %>
                        <a href="/profile/<%= row.opponentAccountId %>"><%= row.opponentName || "Unknown" %></a>
                      <% } else { %>
                        <%= row.opponentName || "Unknown" %>
                      <% } %>
                    </td>
                    <td><%= row.won ? "Win" : "Loss" %></td>
                    <td class="<%= row.delta > 0 ? 'mmr-up' : (row.delta < 0 ? 'mmr-down' : '') %>">
                      <%= row.delta > 0 ? ("+" + row.delta) : String(row.delta) %>
                    </td>
                    <td><%= row.mmrAfter %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% if (mmrHistory.total > mmrHistory.pageSize) { %>
            <div class="news-pager">
              <% if (mmrHistory.page > 1) { %>
                <a class="action news-pager-btn" href="/profile/<%= account.id %>?mmrpage=<%= mmrHistory.page - 1 %>">Prev</a>
              <% } else { %>
                <span class="news-pager-btn" aria-hidden="true"></span>
              <% } %>
              <p class="hint">Page <%= mmrHistory.page %> of <%= Math.ceil(mmrHistory.total / mmrHistory.pageSize) %></p>
              <% if (mmrHistory.page * mmrHistory.pageSize < mmrHistory.total) { %>
                <a class="action news-pager-btn" href="/profile/<%= account.id %>?mmrpage=<%= mmrHistory.page + 1 %>">Next</a>
              <% } else { %>
                <span class="news-pager-btn" aria-hidden="true"></span>
              <% } %>
            </div>
          <% } %>
        <% } %>
      </section>
      <% if (isOwner && !accountEmailVerified(account)) { %>
        <section>
          <h2>Verify email</h2>
          <p class="hint">Verify your email to unlock account features. Until then you can play like a guest.</p>
          <ul class="list">
            <li class="hint">Email: <%= account.email || "not linked" %> (unverified)</li>
          </ul>
          <% if (authEmailEnabled && account.email) { %>
            <form method="post" action="/verify/resend">
<%- include("csrf-field") %>
              <input type="hidden" name="email" value="<%= account.email %>">
              <button type="submit" class="action">Resend verification</button>
            </form>
          <% } %>
        </section>
      <% } else if (isOwner) { %>
        <section>
          <h2>Display name</h2>
          <form method="post" action="/profile/name">
<%- include("csrf-field") %>
            <label for="display-name">Name</label>
            <input id="display-name" name="name" type="text" autocomplete="nickname" required minlength="2" maxlength="32" value="<%= account.name %>">
            <p class="hint">Letters, numbers, spaces, hyphens, apostrophes, and underscores. Costs 1 ticket (up to 3 changes per hour).</p>
            <button type="submit" class="action">Save display name (1 ticket)</button>
          </form>
        </section>
        <section>
          <h2>Account links</h2>
          <p class="hint">Linking a login that already belongs to another account merges that account’s stats and other logins into this one.</p>
          <ul class="list">
            <li class="hint">Email: <%= account.email || "not linked" %><% if (account.email && !accountEmailVerified(account) && authEmailEnabled) { %> (unverified)<% } %></li>
            <li class="hint">Formbar: <%= account.formbar_id ? ("#" + account.formbar_id) : "not linked" %></li>
            <li class="hint">Discord: <%= account.discord_id ? ("#" + account.discord_id) : "not linked" %></li>
          </ul>
          <% if (canLinkFormbar) { %>
            <form method="post" action="/profile/link/formbar">
<%- include("csrf-field") %>
              <button type="submit" class="action">Link Formbar account</button>
            </form>
          <% } %>
          <% if (canLinkDiscord) { %>
            <form method="post" action="/profile/link/discord">
              <button type="submit" class="action">Link Discord account</button>
            </form>
          <% } %>
          <% if (canAddLocal) { %>
            <form method="post" action="/profile/link/local">
<%- include("csrf-field") %>
              <label for="link-email">Email</label>
              <input id="link-email" name="email" type="email" autocomplete="email" required>
              <label for="link-password">Password</label>
              <input id="link-password" name="password" type="password" autocomplete="new-password" minlength="8" required>
              <p class="hint">New email creates credentials here. Password of an existing account merges it here.</p>
              <button type="submit" class="action">Add email &amp; password</button>
            </form>
          <% } %>
        </section>
        <section>
          <h2>Tickets</h2>
          <p class="hint">Buy tickets and view purchase history on the ticket store.</p>
          <p><a class="action" href="/buy">Ticket store</a></p>
        </section>
      <% } %>
    <% } %>
  </div>
  <%- include("suggestion-modal", { nextPath: account ? "/profile/" + account.id : "/" }) %>
</body>
</html>
