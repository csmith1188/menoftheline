<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#121821">
  <title>Rules · Men Of The Line</title>
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="stylesheet" href="/css/landing.css">
</head>
<body>
  <div class="page rules-page">
    <%- include("header") %>
    <div id="rules" class="rules-sheet" aria-labelledby="rules-title">
      <div class="rules-head">
        <h2 id="rules-title"></h2>
      </div>
      <div class="rules-body">
        <canvas id="rules-art" width="640" height="260" aria-hidden="true"></canvas>
        <div id="rules-copy" class="rules-copy"></div>
      </div>
      <div class="rules-nav">
        <button type="button" id="rules-prev" class="action">Back</button>
        <div class="rules-mid">
          <div id="rules-dots" class="rules-dots"></div>
          <p id="rules-page"></p>
        </div>
        <button type="button" id="rules-next" class="action">Next</button>
      </div>
    </div>
  </div>
  <script type="module" src="/js/rules-page.js"></script>
</body>
</html>
