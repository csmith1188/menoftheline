<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include("pwa-head") %>
  <title>High Scores · Men Of The Line</title>
  <link rel="stylesheet" href="/css/landing.css?v=<%= assetVersion %>">
</head>
<body>
  <div class="page">
    <%- include("header") %>
    <% if (notice) { %>
      <p class="notice" role="status"><%= notice %></p>
    <% } %>

    <section>
      <h2>High scores</h2>
      <% if (!leaders.length) { %>
        <p class="hint">No ranked games yet.</p>
      <% } else { %>
        <ol class="scores">
          <% leaders.forEach(function (row) { %>
            <li>
              <a href="/profile/<%= row.id %>"><%= row.name %></a>
              <span><%= row.mmr %> MMR</span>
            </li>
          <% }) %>
        </ol>
      <% } %>
    </section>
  </div>
  <%- include("suggestion-modal", { nextPath: "/scores" }) %>
</body>
</html>
